{
    "framework": "nextjs",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "crons": [
        {
            "path": "/api/cron/process-reminders",
            "schedule": "0 6 * * *"
        },
        {
            "path": "/api/cron/process-followups",
            "schedule": "0 7 * * *"
        },
        {
            "path": "/api/cron/professional-agenda",
            "schedule": "0 8 * * *"
        }
    ]
}